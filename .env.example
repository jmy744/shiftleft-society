# ShiftLeft Society — Environment Variables
# Copy this to .env and fill in your values.
# NEVER commit .env to git. Add .env to .gitignore.

# Qwen/DashScope. Keep the key in your local .env or hosting provider's
# secret manager; never commit a real key. Use the international endpoint for
# keys created in the Singapore/International Model Studio console.
QWEN_API_KEY=your-qwen-api-key-here
QWEN_MODEL=qwen-max
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
OFFLINE_MODE=false

# Application settings
APP_ENV=development
DB_PATH=tribunal_history.db
SHIFTLEFT_API_KEY=
ALLOWED_ORIGINS=http://localhost:8000
MAX_CODE_CHARS=100000
MAX_CONCURRENT_JOBS=4

# Optional: required only for GitHub PR integration
GITHUB_TOKEN=ghp_your_personal_access_token_here
GITHUB_WEBHOOK_SECRET=your-webhook-secret-here

# Set automatically on Alibaba Cloud ECS instances
ALIBABA_CLOUD_REGION=ap-southeast-1
ECS_INSTANCE_ID=i-your-instance-id
